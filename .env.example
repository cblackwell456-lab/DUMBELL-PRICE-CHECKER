# Optional: copy this file to .env to also get GitHub issue alerts (GitHub then
# emails / pushes them to your phone) when the tracker runs on your PC.
# Without it you still get desktop pop-up notifications.
#
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new
#   Repository access: only cblackwell456-lab/DUMBELL-PRICE-CHECKER
#   Permissions: Issues -> Read and write
GITHUB_TOKEN=
GITHUB_REPOSITORY=cblackwell456-lab/DUMBELL-PRICE-CHECKER
GITHUB_REPOSITORY_OWNER=cblackwell456-lab
